# Container Doctor - stack environment variables.
#
# Set them wherever your Docker manager keeps a stack's environment, or in a
# .env file next to the compose file (compose.example.yaml passes them all).
# Nothing here belongs in git; this file only documents the names and defaults.
#
# Lines starting with # show a setting's default; uncomment one to change it.
# Secrets, sign-in and the addresses a secret is sent to can only be set here.
# Everything else can also be changed on the dashboard's Settings page; a
# variable set here overrides the page, so leave one unset to manage it there.

# --- required --------------------------------------------------------------
# Anthropic API key. Without it the doctor still detects incidents and shows
# them in the dashboard - it just cannot explain them.
ANTHROPIC_API_KEY=sk-ant-...

# --- sign-in ---------------------------------------------------------------
# Protects the dashboard. Required; a long random one, e.g.
# openssl rand -base64 24. With neither a password nor OIDC set, the
# dashboard and its API refuse every request, because the dashboard can
# restart containers. Known placeholders (change-me, changeme, password,
# admin, doctor, secret, 123456, the user name...) are refused: the doctor
# logs a warning and treats sign-in as unconfigured. Under 12 characters
# works, with a warning at startup.
DOCTOR_WEB_PASSWORD=
# The user name that password signs in as.
DOCTOR_WEB_USER=doctor
# OIDC sign-in through your own provider (Pocket ID, Authentik, Keycloak...).
# Empty issuer turns it off. The provider's callback URL is
# <DOCTOR_PUBLIC_URL>/auth/callback.
#DOCTOR_OIDC_ISSUER=https://id.example.com
#DOCTOR_OIDC_CLIENT_ID=
#DOCTOR_OIDC_CLIENT_SECRET=
# The dashboard's own address, as the browser reaches it. Also used for the
# links in notifications.
#DOCTOR_PUBLIC_URL=https://doctor.example.com
# Comma-separated groups allowed in; empty lets in any account the provider
# authenticates.
#DOCTOR_OIDC_ALLOWED_GROUPS=
#DOCTOR_OIDC_GROUPS_CLAIM=groups
#DOCTOR_OIDC_SCOPES=openid profile email groups
# Signs the session cookie. Unset, one is generated once and kept in the data
# directory (session_secret, mode 0600). openssl rand -base64 32
#DOCTOR_SESSION_SECRET=
# Hours an unused session lasts.
#DOCTOR_SESSION_HOURS=12
# With OIDC on, the password is refused unless this is true - a way back in
# when the provider itself is what is broken.
#DOCTOR_WEB_PASSWORD_FALLBACK=false
# Settings can be changed on the Settings page by anyone who can sign in; a
# variable set here always overrides what was saved there. false makes the
# page read-only.
#DOCTOR_SETTINGS_EDITABLE=true

# --- autonomy --------------------------------------------------------------
# observe  - diagnose and notify, never touch anything   <- start here
# suggest  - propose an action, wait for you to approve it in the dashboard
# auto     - apply allowed actions without asking
DOCTOR_MODE=observe
DOCTOR_AUTO_ACTIONS=restart_container
DOCTOR_MIN_CONFIDENCE=0.75
# Comma-separated container names the doctor must never look at or touch.
DOCTOR_IGNORE_CONTAINERS=
# true watches only containers labelled doctor.enable=true.
#DOCTOR_REQUIRE_OPT_IN=false
# The doctor's own container name, which it never diagnoses or restarts.
#DOCTOR_SELF_NAME=container-doctor

# --- model -----------------------------------------------------------------
DOCTOR_LLM_PROVIDER=anthropic
# Built-in prices (USD per million tokens, in / out): claude-opus-5-5 4/20,
# claude-sonnet-5-5 2/10, claude-haiku-5-5 0.10/0.50, claude-fable-5 10/50.
DOCTOR_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - how hard the model thinks per incident.
# Only applies to Anthropic models; ignored elsewhere.
DOCTOR_EFFORT=medium
# Upper bound on the length of one answer.
#DOCTOR_MAX_OUTPUT_TOKENS=4000
# No new calls today once recorded spend reaches this (calls in flight can
# overshoot slightly; set a limit with the provider for an absolute ceiling).
# Manual re-diagnoses count too. 0 disables the cap.
DOCTOR_DAILY_USD_BUDGET=1.00
# No new calls after this many today. This is the cap that matters on a
# free tier, where the dollar meter reads zero all day. 0 disables it.
DOCTOR_DAILY_CALL_LIMIT=0
# USD per million tokens, so the spend meter works for a non-Anthropic vendor.
# Leave at -1 to price known Anthropic models from the built-in table and treat
# everything else as free. Set both to 0 to say "this really is free".
DOCTOR_PRICE_IN_PER_MTOK=-1
DOCTOR_PRICE_OUT_PER_MTOK=-1
# Retries on 429 / 5xx, honouring Retry-After. Free tiers rate-limit hard.
DOCTOR_LLM_MAX_RETRIES=3
DOCTOR_LLM_TIMEOUT=180
# Reasoning models reject `temperature` (GPT-6 Luna does at any reasoning
# effort above `none`). The request drops it automatically if the vendor
# complains; set -1 to never send it and skip the extra round trip.
DOCTOR_LLM_TEMPERATURE=0.2
# Identical failures reuse a stored diagnosis for this many hours (no API call).
DOCTOR_DIAGNOSIS_CACHE_HOURS=6

# --- other vendors ---------------------------------------------------------
# Set DOCTOR_LLM_PROVIDER=openai and point at any OpenAI-compatible endpoint.
# The base URL can only be set here, never from the Settings page, since the
# API key is sent to it. Verify it in one command before you rely on it:
#     docker compose exec container-doctor python -m app.selftest
#
# Free tiers, limits and prices below are as of October 2026 - check the
# vendor's page, these change often.
#
# Google Gemini - free tier, no card. See https://sebastianbuechler.github.io/container-doctor/guides/models/
# ("Free options, ranked") for the privacy caveat: free-tier inputs may be
# used for training.
# DOCTOR_LLM_PROVIDER=openai
# DOCTOR_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DOCTOR_OPENAI_API_KEY=<AI Studio key>
# DOCTOR_MODEL=gemini-3-flash
# DOCTOR_DAILY_CALL_LIMIT=300
#
# OpenRouter - one key, every vendor. Swap DOCTOR_MODEL to A/B them.
# GPT-6 Luna is the cheap-but-capable pick: ~$0.0002 per incident.
# Prices move - check the model page and update the two _PER_MTOK values.
# DOCTOR_LLM_PROVIDER=openai
# DOCTOR_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# DOCTOR_OPENAI_API_KEY=<OpenRouter key>
# DOCTOR_MODEL=openai/gpt-6-luna
# DOCTOR_PRICE_IN_PER_MTOK=0.10
# DOCTOR_PRICE_OUT_PER_MTOK=0.50
#
# OpenRouter `:free` variants cost nothing but are rate-limited hard
# (20 req/min; 50/day under $10 of credits, 1000/day above).
# DOCTOR_MODEL=google/gemma-4-31b-it:free
# DOCTOR_DAILY_CALL_LIMIT=40
#
# Groq - free, very fast, open-weight models.
# DOCTOR_LLM_PROVIDER=openai
# DOCTOR_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# DOCTOR_OPENAI_API_KEY=<Groq key>
# DOCTOR_MODEL=openai/gpt-oss-120b
# DOCTOR_DAILY_CALL_LIMIT=500
#
# Local, nothing leaves the host - Ollama, LM Studio, vLLM.
# DOCTOR_LLM_PROVIDER=openai
# DOCTOR_OPENAI_BASE_URL=http://ollama:11434/v1
# DOCTOR_OPENAI_API_KEY=ollama
# DOCTOR_MODEL=qwen3:14b

# --- guardrails ------------------------------------------------------------
DOCTOR_MAX_ACTIONS_PER_CONTAINER_PER_HOUR=3
DOCTOR_MAX_ACTIONS_GLOBAL_PER_HOUR=10
DOCTOR_ACTION_COOLDOWN_MINUTES=30
# Seconds to wait after an action before checking whether it actually helped.
DOCTOR_VERIFY_DELAY=45
# Set to 0 to close the socket proxy's only write route. The doctor then
# physically cannot restart anything, whatever mode it is in. (This maps to
# ALLOW_RESTARTS on the proxy; the global POST gate is always off, which is
# what keeps /containers/create - arbitrary host mounts - out of reach.)
DOCTOR_PROXY_ALLOW_POST=1
# 0 denies the read-only GET /images/<name>/json on the proxy; the image
# update check then says it cannot run.
#DOCTOR_PROXY_ALLOW_IMAGES=1
# Where the doctor reaches Docker. Point it at a socket proxy you already run
# (see https://sebastianbuechler.github.io/container-doctor/guides/socket-proxy/,
# "Reusing yours instead").
#DOCTOR_DOCKER_HOST=tcp://doctor-socket-proxy:2375

# --- detection -------------------------------------------------------------
DOCTOR_POLL_INTERVAL=30
# Containers read at once during a poll. Applies on restart.
#DOCTOR_POLL_CONCURRENCY=6
# Share of the WHOLE host's CPU, not of a single core.
DOCTOR_CPU_THRESHOLD=85
# Share of the container's memory limit (or of host RAM when no limit is set).
DOCTOR_MEM_THRESHOLD=90
DOCTOR_RESOURCE_BREACH_POLLS=4
DOCTOR_RESTART_LOOP_COUNT=3
DOCTOR_RESTART_LOOP_WINDOW_MINUTES=15
DOCTOR_LOG_LINES=120
# Log lines older than this are never read; 0 reads the whole tail.
#DOCTOR_LOG_MAX_AGE_MINUTES=60
# The wording that counts as an error, as a Python regular expression. The
# default matches fatal, panic, traceback, segfault, out of memory, oomkill,
# connection refused, no such host, permission denied, disk full, no space
# left, deadlock and unhandled exception, case-insensitively.
#DOCTOR_LOG_ERROR_PATTERN=
# Lines matching DOCTOR_LOG_ERROR_PATTERN by wording.
DOCTOR_LOG_ERROR_BURST=5
# Lines the app itself marked ERROR. Higher, because one ERROR line is weaker
# evidence than "no space left on device".
DOCTOR_LOG_LEVEL_ERROR_BURST=10
# A single FATAL / CRITICAL line opens an incident on its own.
DOCTOR_LOG_FATAL_THRESHOLD=1
# Redeploys. A stop that Docker announced with a signal (docker stop, Compose,
# a Docker manager) is not a crash, and a container that exits and is replaced
# within DOCTOR_DIE_GRACE_SECONDS was redeployed. For
# DOCTOR_DEPLOY_SETTLE_MINUTES after any redeploy, errors other containers log
# while it restarts do not count, and a failing health check waits. 0 turns
# the window off.
DOCTOR_DEPLOY_SETTLE_MINUTES=3
DOCTOR_DIE_GRACE_SECONDS=30
# Log lines to never count, host-wide. Prefer the per-container label
# `doctor.ignore_log` - noise is usually one container's habit.
DOCTOR_LOG_IGNORE_PATTERN=

# --- storage ---------------------------------------------------------------
# Free space is a property of the filesystem, so /data reports all of the
# volume it lives on without mounting it. To watch another volume, mount an
# empty directory on it read-only (never the volume root) and add it here:
# one path per volume, each with its own forecast.
DOCTOR_DISK_PATHS=/data
# A watched filesystem this full (%) is a warning...
DOCTOR_DISK_THRESHOLD=95
# ...and this full, critical.
#DOCTOR_DISK_CRITICAL=98
# The fill-rate forecast: an incident when a filesystem is on course to be
# full within DOCTOR_DISK_FORECAST_DAYS, critical within the _CRITICAL_DAYS.
# The rate is fitted over DOCTOR_DISK_TREND_WINDOW_DAYS of samples, one per
# DOCTOR_DISK_SAMPLE_MINUTES.
#DOCTOR_DISK_FORECAST_DAYS=21
#DOCTOR_DISK_FORECAST_CRITICAL_DAYS=5
#DOCTOR_DISK_TREND_WINDOW_DAYS=14
#DOCTOR_DISK_SAMPLE_MINUTES=60
# Software RAID (md) state; off turns the RAID check off.
#DOCTOR_MDSTAT_PATH=/proc/mdstat
# Array layout, scrub results and per-disk read errors; off skips them.
#DOCTOR_SYSFS_PATH=/sys
# New corrected read errors on one drive within a day that make its warning
# critical (0 never escalates), and how many days a drive warns after its
# last new one.
#DOCTOR_RAID_ERRORS_PER_DAY=10
#DOCTOR_RAID_ERRORS_DAYS=7
# Drive health from the doctor-smart sidecar (Storage page). The sidecar is
# opt-in, since it has raw disk access: start the stack with
# `docker compose --profile smart up -d`, or set COMPOSE_PROFILES=smart.
# "auto" finds the drives; or list their device files, space or comma
# separated. Give SATA drives their type, /dev/sata1;sat, or smartctl may
# read a WD as SCSI.
#COMPOSE_PROFILES=smart
#DOCTOR_SMART_DEVICES=auto
#DOCTOR_SMART_URL=http://doctor-smart:9633/metrics
#DOCTOR_SMART_TEMP_C=55
#DOCTOR_SMART_NVME_TEMP_C=70
#DOCTOR_SMART_WEAR_PCT=90

# --- the host and the network ----------------------------------------------
# The host itself (Host page). Read from /proc, which is system-wide; off
# turns it off. An incident opens when a condition lasts DOCTOR_HOST_BREACH_POLLS.
#DOCTOR_PROC_PATH=/proc
#DOCTOR_HOST_MEM_AVAILABLE_PCT=5
#DOCTOR_HOST_SWAP_IN_PER_S=256
#DOCTOR_HOST_LOAD_PER_CORE=2.0
#DOCTOR_HOST_IOWAIT_PCT=40
#DOCTOR_HOST_TEMP_C=80
#DOCTOR_HOST_BREACH_POLLS=10
# One stored point per this many minutes, for the Host page's charts and each
# drive's temperature and sleep.
#DOCTOR_HOST_SAMPLE_MINUTES=5
# Internet and DNS (Network page), checked from the doctor's container.
# DOCTOR_NET_CHECK_SECONDS=0 turns them off; "none" empties a list.
#DOCTOR_NET_CHECK_SECONDS=60
#DOCTOR_NET_TIMEOUT=5
#DOCTOR_NET_FAIL_ROUNDS=3
#DOCTOR_NET_TCP_TARGETS=1.1.1.1:443,9.9.9.9:443
#DOCTOR_NET_DNS_NAMES=cloudflare.com,github.com
# Your own DNS servers, each checked on its own: ip, ip:port or a container name.
#DOCTOR_NET_DNS_SERVERS=192.168.1.2
#DOCTOR_NET_HTTP_URLS=https://www.cloudflare.com/cdn-cgi/trace

# --- incidents -------------------------------------------------------------
# A recurrence within this many hours of the last sighting folds into the
# open incident instead of opening a new one.
#DOCTOR_INCIDENT_DEDUP_HOURS=24
# An incident whose condition has not re-fired for this long resolves itself;
# 0 turns that off.
#DOCTOR_AUTO_RESOLVE_HOURS=12
DOCTOR_RETENTION_DAYS=30

# --- image updates -----------------------------------------------------------
# How often to ask the registries what they publish; 0 turns the check off.
#DOCTOR_IMAGE_CHECK_HOURS=12
# Read GitHub release notes for images with a newer version.
#DOCTOR_RELEASE_NOTES=true
# Days a release must be on Docker Hub before it counts as newer - match your
# Dependabot or Renovate cooldown, if you use one. 0: at once.
#DOCTOR_UPDATE_COOLDOWN_DAYS=3
# Redeploy a stack from the Updates page when its image has a new build. The
# doctor runs a GitHub Actions workflow in the repository the stacks are
# deployed from, which redeploys the stack - see examples/redeploy-workflow.yml
# for what it must accept. A fine-grained token on that repository only, with
# Actions: read and write, and Contents: read. Unset, the page only reports.
#DOCTOR_GITHUB_TOKEN=github_pat_...
#DOCTOR_DEPLOY_REPO=owner/repository
#DOCTOR_DEPLOY_WORKFLOW=deploy-stacks.yml
#DOCTOR_DEPLOY_REF=main

# --- what deploys the stacks --------------------------------------------------
# In words, for the diagnosis, the hand-off brief and the Settings page's
# labels; neither changes what the doctor does. Both optional.
# The Docker manager's name: Portainer, Coolify, Komodo, Dockge...
#DOCTOR_DOCKER_MANAGER=Portainer
# How a change reaches the host.
#DOCTOR_DEPLOY_METHOD=a push to main; a GitHub Actions workflow calls each changed stack's webhook

# --- the host ------------------------------------------------------------------
# What the doctor runs on. auto reads it from the kernel: a Synology says so,
# and then DSM's own md0/md1 system arrays are not called degraded. Set
# synology or generic to override. The name is what diagnoses and the Host
# page call it; empty says "the host".
#DOCTOR_HOST_KIND=auto
#DOCTOR_HOST_NAME=tower

# --- the briefing ----------------------------------------------------------
# The summary at the top of the dashboard. false leaves the facts without a
# model's words. An empty model uses DOCTOR_MODEL; a smaller one is plenty.
#DOCTOR_BRIEFING=true
#DOCTOR_BRIEFING_MODEL=
#DOCTOR_BRIEFING_REFRESH_MINUTES=15

# --- what goes to a model ---------------------------------------------------
# Every request as it was sent, on the LLM page, for this many days. 0 keeps
# none; the daily spend totals are kept either way.
DOCTOR_LLM_LOG_DAYS=14

# --- the classifier ------------------------------------------------------------
# A decision model's second opinion on judgement signals (error bursts, health
# checks, CPU/memory) before they become incidents. off | shadow | on.
# shadow records verdicts and changes nothing - run it that way first.
DOCTOR_CLASSIFIER=off
# openrouter: a decision model via OpenRouter's Decisions API (Jev).
# chat: the diagnosis's own model; uncalibrated, so it never hides anything.
DOCTOR_CLASSIFIER_PROVIDER=openrouter
DOCTOR_CLASSIFIER_MODEL=typesafe/jev-1.13
# The Decisions API endpoint the key is sent to.
#DOCTOR_CLASSIFIER_URL=https://openrouter.ai/api/alpha/decisions
# An OpenRouter key. Give it its own credit limit on openrouter.ai.
# Unset: the diagnosis's DOCTOR_OPENAI_API_KEY, if that is an OpenRouter one.
DOCTOR_CLASSIFIER_API_KEY=
# Likely-noise probability at or above which a signal opens no incident (on).
DOCTOR_CLASSIFIER_SUPPRESS_AT=0.9
# Its own caps, separate from the diagnosis's.
DOCTOR_CLASSIFIER_DAILY_CALLS=500
DOCTOR_CLASSIFIER_DAILY_USD=0.10
DOCTOR_CLASSIFIER_MAX_PER_MINUTE=10
DOCTOR_CLASSIFIER_CACHE_HOURS=6
DOCTOR_CLASSIFIER_TIMEOUT=5
# Evidence sent per call, in characters (about 3,000 tokens).
#DOCTOR_CLASSIFIER_MAX_STATE_CHARS=12000
# Input price, USD per million tokens, when OpenRouter does not report the
# cost itself. Jev's as of October 2026 - check the model page.
#DOCTOR_CLASSIFIER_PRICE_PER_MTOK=0.042

# --- notifications ---------------------------------------------------------
# ntfy push notifications, off until both a server URL and a topic are set.
# The URL and token are environment-only. On ntfy.sh anyone who
# knows or guesses a topic's name can read it, so pick a long random one
# (openssl rand -hex 16), protect it with an access token, or run your own
# ntfy server.
#DOCTOR_NTFY_URL=https://ntfy.sh
DOCTOR_NTFY_TOPIC=
DOCTOR_NTFY_TOKEN=

# --- deployment ----------------------------------------------------------------
# Read by compose.example.yaml itself: the dashboard's port on the host, and
# where the database lives on the host and who owns it. Create the directory
# and chown it to DOCTOR_UID:DOCTOR_GID before the first start.
#DOCTOR_PORT=8080
#DOCTOR_DATA_VOLUME=./data
#DOCTOR_UID=1000
#DOCTOR_GID=1000
# Pin to a specific published image instead of tracking latest, e.g. X.Y.Z or
# a sha-<commit> tag from ghcr.io, to roll back or freeze a deploy.
DOCTOR_IMAGE_TAG=latest
TZ=UTC
DOCTOR_LOG_LEVEL=INFO
# Outside compose.example.yaml, the image also reads DOCTOR_WEB_HOST and
# DOCTOR_WEB_PORT (where it listens, 0.0.0.0 and 8080) and DOCTOR_DATA_DIR
# (where the database is inside the container, /data). The compose file does
# not pass them: its port mapping and health check expect the defaults.
