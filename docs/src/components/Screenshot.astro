---
// A screenshot of the dashboard in the reader's theme: the light and the dark
// one are both on the page, and Starlight shows the one that matches.
// Taken by `python -m demo.record`; see contributing/documentation.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
	caption?: string;
	phone?: boolean;
}

const { name, alt, caption, phone = false } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.webp', { eager: true });
const find = (theme: string) => {
	const shot = shots[`../assets/screenshots/${name}-${theme}.webp`];
	if (!shot) throw new Error(`no screenshot ${name}-${theme}.webp - run python -m demo.record`);
	return shot.default;
};
// Taken at twice the size they are shown; the browser picks what it needs.
const widths = phone ? [300, 600, 780] : [720, 1440, 2560];
const sizes = phone ? '300px' : '(min-width: 72rem) 46rem, 100vw';
---

<figure class:list={['screenshot', { phone }]}>
	<Image src={find('light')} alt={alt} widths={widths} sizes={sizes} class="dark:sl-hidden" />
	<Image src={find('dark')} alt={alt} widths={widths} sizes={sizes} class="light:sl-hidden" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.screenshot {
		margin-block: 1.5rem;
	}
	/* No display here: Starlight hides the other theme's image with it. */
	.screenshot :global(img) {
		vertical-align: middle;
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		box-shadow: var(--sl-shadow-md);
	}
	.screenshot.phone {
		max-width: 300px;
		margin-inline: auto;
	}
	.screenshot.phone :global(img) {
		border-radius: 1.5rem;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
