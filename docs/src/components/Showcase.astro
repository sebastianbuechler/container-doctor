---
// A dashboard screenshot in a browser window, optionally with the phone
// version over its corner. Each image follows the reader's theme. On a
// narrow screen the two sit side by side in a row you swipe, phone first,
// rather than one above the other.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** The desktop screenshot's name in src/assets/screenshots, without -light/-dark. */
	desktop: string;
	/** The phone screenshot's name, if this view has one. */
	phone?: string;
	alt: string;
}

const { desktop, phone, alt } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.webp', { eager: true });
const find = (name: string, theme: string) => {
	const shot = shots[`../assets/screenshots/${name}-${theme}.webp`];
	if (!shot) throw new Error(`no screenshot ${name}-${theme}.webp - run python -m demo.record`);
	return shot.default;
};
---

<div class:list={['showcase', { 'with-phone': phone }]}>
	<div class="frames">
		<figure class="window">
			<div class="bar" aria-hidden="true"><span></span><span></span><span></span></div>
			<Image src={find(desktop, 'light')} {alt} widths={[960, 1920, 2560]} sizes="(min-width: 75rem) 64rem, 100vw" class="dark:sl-hidden" />
			<Image src={find(desktop, 'dark')} {alt} widths={[960, 1920, 2560]} sizes="(min-width: 75rem) 64rem, 100vw" class="light:sl-hidden" />
		</figure>
		{
			phone && (
				<figure class="phone">
					<Image src={find(phone, 'light')} alt={`${alt}, on a phone`} widths={[260, 520, 780]} sizes="15rem" class="dark:sl-hidden" />
					<Image src={find(phone, 'dark')} alt={`${alt}, on a phone`} widths={[260, 520, 780]} sizes="15rem" class="light:sl-hidden" />
				</figure>
			)
		}
	</div>
	{
		phone && (
			<div class="switch" aria-hidden="true">
				<button type="button" class="on" tabindex="-1">Phone</button>
				<button type="button" tabindex="-1">Desktop</button>
			</div>
		)
	}
</div>

<script>
	// In the swipeable row: mark which picture is in view, let the labels
	// switch to it, and fit the row's height to it - the phone is much taller.
	for (const showcase of document.querySelectorAll('.showcase.with-phone')) {
		const frames = showcase.querySelector<HTMLElement>('.frames')!;
		const slides = [showcase.querySelector<HTMLElement>('.phone')!, showcase.querySelector<HTMLElement>('.window')!];
		const buttons = showcase.querySelectorAll('.switch button');
		const swiping = () => getComputedStyle(frames).overflowX === 'auto';
		const show = (i: number) => {
			buttons.forEach((b, j) => b.classList.toggle('on', i === j));
			const pad = parseFloat(getComputedStyle(frames).paddingTop) + parseFloat(getComputedStyle(frames).paddingBottom);
			frames.style.height = swiping() ? `${slides[i].offsetHeight + pad}px` : '';
		};
		let current = 0;
		frames.addEventListener('scroll', () => {
			const i = frames.scrollLeft > (frames.scrollWidth - frames.clientWidth) / 2 ? 1 : 0;
			if (i !== current) show((current = i));
		}, { passive: true });
		buttons.forEach((b, i) => b.addEventListener('click', () => {
			frames.scrollTo({ left: i ? frames.scrollWidth : 0, behavior: 'smooth' });
		}));
		new ResizeObserver(() => show(current)).observe(slides[0]);
	}
</script>

<style>
	.showcase {
		max-width: 72rem;
		margin-inline: auto;
	}
	.frames {
		position: relative;
	}
	figure {
		margin: 0;
	}
	figure :global(img) {
		vertical-align: middle;
		width: 100%;
		height: auto;
	}
	/* The same width with or without the phone, so switching views does not jump. */
	.window {
		width: 88%;
		margin-inline: auto;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		overflow: hidden;
		background: var(--sl-color-gray-6);
		box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.35);
	}
	.bar {
		display: flex;
		gap: 0.4rem;
		padding: 0.6rem 0.8rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.bar span {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: var(--sl-color-gray-4);
	}
	.phone {
		width: 15rem;
		border: 0.55rem solid #111;
		border-radius: 2.2rem;
		overflow: hidden;
		background: #111;
		box-shadow: 0 30px 50px -15px rgb(0 0 0 / 0.5);
	}
	/* The phone over the window's bottom-right corner. */
	.with-phone .frames {
		padding-bottom: 4rem;
	}
	.with-phone .phone {
		position: absolute;
		right: 0;
		bottom: 0;
	}
	.switch {
		display: none;
	}

	@media (max-width: 50rem) {
		.window {
			width: 100%;
			border-radius: 0.6rem;
		}
		.bar {
			padding: 0.4rem 0.6rem;
		}
		.bar span {
			width: 0.45rem;
			height: 0.45rem;
		}
		/* Side by side in a row you swipe: the phone, then the desktop peeking in. */
		.with-phone .frames {
			display: flex;
			align-items: flex-start;
			gap: 1rem;
			padding: 0.5rem 0 1.5rem;
			overflow-x: auto;
			overflow-y: hidden;
			transition: height 0.25s ease;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}
		.with-phone .frames::-webkit-scrollbar {
			display: none;
		}
		.with-phone .phone,
		.with-phone .window {
			flex: none;
			scroll-snap-align: center;
			box-shadow: 0 16px 30px -14px rgb(0 0 0 / 0.45);
		}
		.with-phone .phone {
			order: -1;
			position: static;
			width: min(13rem, 62%);
			margin-left: calc((100% - min(13rem, 62%)) / 2);
			border-width: 0.4rem;
			border-radius: 1.6rem;
		}
		.with-phone .window {
			width: 92%;
			margin-right: 4%;
		}
		.switch {
			display: flex;
			justify-content: center;
			gap: 0.4rem;
		}
		.switch button {
			margin: 0;
			padding: 0.1rem 0.6rem;
			border: 0;
			border-radius: 999px;
			background: none;
			font: inherit;
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
			cursor: pointer;
		}
		.switch button.on {
			background: var(--sl-color-gray-6);
			color: var(--sl-color-white);
		}
	}
</style>
